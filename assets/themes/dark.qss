/* ============================================================
   Reblum — Dark Theme
   ============================================================ */

QWidget {
    background-color: #111111;
    color: #d0d0d0;
    font-family: "Inter", "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 12px;
}

/* ── Toolbar (unified title bar) ─────────────────────────── */
QMainWindow {
    background-color: #19191A;
}

QWidget#MainToolbar {
    background-color: #19191A;
    spacing: 4px;
    padding: 0 12px;
}

QWidget#MainToolbar QWidget {
    background: transparent;
}

QWidget#MainToolbar QWidget#ImageMetaBadge {
    background: #111111;
    border-radius: 8px;
}

QWidget#MainToolbar QLabel#ImageMeta {
    color: #98989B;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}

QLabel#FileName {
    color: #747477;
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    background: transparent;
}

QPushButton#ToolbarIconBtn,
QPushButton#ToolbarInfoBtn {
    background: transparent;
    border: none;
    padding: 0;
}

QPushButton#ToolbarIconBtn:hover,
QPushButton#ToolbarInfoBtn:hover {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
}

QPushButton#ToolbarInfoBtn {
    padding-top: 1px;
    padding-bottom: 0;
}

QWidget#MainToolbar QWidget#TrialBadge {
    background: #221C2F;
    border: 1px solid #282F59;
    border-radius: 4px;
}

QLabel#TrialBadgeText {
    color: #8FC4FF;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    background: transparent;
}

/* ── Effect progress bar ─────────────────────────────────── */
QProgressBar#EffectProgress {
    border: none;
    background-color: #1e1e1e;
    max-height: 3px;
}
QProgressBar#EffectProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4d1020, stop:1 #c8622a);
    border-radius: 0px;
}

/* ── Right panel ─────────────────────────────────────────── */
QWidget#RightPanel {
    background-color: #19191A;
}

EffectPanel,
EffectPanel QWidget {
    background: transparent;
}

QWidget#ProgressContainer {
    background: transparent;
}

QFrame#PanelSeparatorV {
    color: #282829;
    background-color: #282829;
    border: none;
    min-width: 1px;
    max-width: 1px;
}

QLabel#EffectName {
    color: #cccccc;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QLabel#SliderLabel {
    color: #666666;
    font-size: 10px;
    background: transparent;
}

QFrame#PanelSeparator {
    color: #282829;
    background-color: #282829;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

/* ── Bottom bar ──────────────────────────────────────────── */
QWidget#BottomBar {
    background-color: #19191A;
}

QWidget#BottomImageSection,
QWidget#BottomRightSection {
    background: transparent;
}

QPushButton#ZoomFit,
QPushButton#Zoom100 {
    background-color: transparent;
    color: #777777;
    border: none;
    font-size: 11px;
    padding: 2px 8px;
}

QPushButton#ZoomFit:hover,
QPushButton#Zoom100:hover {
    color: #cccccc;
}

QPushButton#ZoomFit:checked,
QPushButton#Zoom100:checked {
    color: #ffffff;
}

QPushButton#ExportButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4d1020, stop:1 #c8622a);
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 0px 12px;
}

QPushButton#ExportButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #5e1528, stop:1 #d97038);
}
