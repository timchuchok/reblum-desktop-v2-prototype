/* ============================================================
   Reblum — Dark Theme
   ============================================================ */

QWidget {
    background-color: #111111;
    color: #d0d0d0;
    font-family: "Inter", "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 12px;
}

/* ── Toolbar (unified title bar) ─────────────────────────── */
QWidget#MainToolbar {
    background-color: #0d0d0d;
    border-bottom: 1px solid #222222;
    spacing: 4px;
    padding: 0 12px;
}

QLabel#ImageMeta {
    color: #888888;
    font-size: 11px;
}

QLabel#FileName {
    color: #cccccc;
    font-size: 11px;
}

QLabel#TrialBadge {
    color: #8FC4FF;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0px;
    padding: 2px 8px;
    border: 1px solid #333333;
border-radius: 3px;
}

/* ── Effect progress bar ─────────────────────────────────── */
QProgressBar#EffectProgress {
    border: none;
    background-color: #1e1e1e;
    max-height: 3px;
}
QProgressBar#EffectProgress::chunk {
    background-color: #c8622a;
    border-radius: 0px;
}

/* ── Right panel ─────────────────────────────────────────── */
QWidget#RightPanel {
    background-color: #161616;
    border-left: 1px solid #222222;
}

QLabel#EffectName {
    color: #cccccc;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QLabel#SliderLabel {
    color: #666666;
    font-size: 10px;
    background: transparent;
}

QFrame#PanelSeparator {
    color: #2a2a2a;
    background-color: #2a2a2a;
    border: none;
    max-height: 1px;
}

/* ── Bottom bar ──────────────────────────────────────────── */
QWidget#BottomBar {
    background-color: #0d0d0d;
    border-top: 1px solid #222222;
}

QPushButton#ZoomFit,
QPushButton#Zoom100 {
    background-color: transparent;
    color: #777777;
    border: none;
    font-size: 11px;
    padding: 2px 8px;
}

QPushButton#ZoomFit:hover,
QPushButton#Zoom100:hover {
    color: #cccccc;
}

QPushButton#ZoomFit:checked,
QPushButton#Zoom100:checked {
    color: #ffffff;
}

QPushButton#ExportButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4d1020, stop:1 #c8622a);
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 0px 12px;
}

QPushButton#ExportButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #5e1528, stop:1 #d97038);
}
