/* ============================================================
   Reblum — Light Theme
   ============================================================ */

QWidget {
    background-color: #f2f2f2;
    color: #222222;
    font-family: "Inter", "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 12px;
}

/* ── Top bar ─────────────────────────────────────────────── */
QWidget#TopBar {
    background-color: #e8e8e8;
    border-bottom: 1px solid #d0d0d0;
}

QLabel#ImageMeta {
    color: #999999;
    font-size: 11px;
}

QLabel#FileName {
    color: #444444;
    font-size: 11px;
}

QLabel#TrialBadge {
    color: #999999;
    font-size: 11px;
    padding: 2px 8px;
    border: 1px solid #cccccc;
    border-radius: 3px;
}

/* ── Right panel ─────────────────────────────────────────── */
QWidget#RightPanel {
    background-color: #ebebeb;
    border-left: 1px solid #d0d0d0;
}

QLabel#EffectName {
    color: #333333;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QLabel#SliderLabel {
    color: #999999;
    font-size: 10px;
    background: transparent;
}

QFrame#PanelSeparator {
    color: #d0d0d0;
    background-color: #d0d0d0;
    border: none;
    max-height: 1px;
}

/* ── Bottom bar ──────────────────────────────────────────── */
QWidget#BottomBar {
    background-color: #e8e8e8;
    border-top: 1px solid #d0d0d0;
}

QPushButton#ZoomFit,
QPushButton#Zoom100 {
    background-color: transparent;
    color: #999999;
    border: none;
    font-size: 11px;
    padding: 2px 8px;
}

QPushButton#ZoomFit:hover,
QPushButton#Zoom100:hover {
    color: #444444;
}

QPushButton#ZoomFit:checked,
QPushButton#Zoom100:checked {
    color: #111111;
}

QPushButton#ExportButton {
    background-color: #c8622a;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 18px;
}

QPushButton#ExportButton:hover {
    background-color: #d9703a;
}
