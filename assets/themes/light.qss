/* ============================================================
   Reblum — Light Theme
   ============================================================ */

QWidget {
    background-color: #f2f2f2;
    color: #222222;
    font-family: "Inter", "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 12px;
}

/* ── Toolbar (unified title bar) ─────────────────────────── */
QWidget#MainToolbar {
    background-color: #e8e8e8;
    border-bottom: 1px solid #d0d0d0;
    spacing: 4px;
    padding: 0 12px;
}

QLabel#ImageMeta {
    color: #999999;
    font-size: 11px;
}

QLabel#FileName {
    color: #444444;
    font-size: 11px;
}

QLabel#TrialBadge {
    color: #8FC4FF;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0px;
    padding: 2px 8px;
    border: 1px solid #c0d8f5;
    border-radius: 3px;
}

/* ── Effect progress bar ─────────────────────────────────── */
QProgressBar#EffectProgress {
    border: none;
    background-color: #e0e0e0;
    max-height: 3px;
}
QProgressBar#EffectProgress::chunk {
    background-color: #c8622a;
    border-radius: 0px;
}

/* ── Right panel ─────────────────────────────────────────── */
QWidget#RightPanel {
    background-color: #ebebeb;
}

QFrame#PanelSeparatorV {
    color: #d0d0d0;
    background-color: #d0d0d0;
    border: none;
    min-width: 1px;
    max-width: 1px;
}

QLabel#EffectName {
    color: #333333;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QLabel#SliderLabel {
    color: #999999;
    font-size: 10px;
    background: transparent;
}

QFrame#PanelSeparator {
    color: #d0d0d0;
    background-color: #d0d0d0;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

/* ── Bottom bar ──────────────────────────────────────────── */
QWidget#BottomBar {
    background-color: #e8e8e8;
    border-top: 1px solid #d0d0d0;
}

QPushButton#ZoomFit,
QPushButton#Zoom100 {
    background-color: transparent;
    color: #999999;
    border: none;
    font-size: 11px;
    padding: 2px 8px;
}

QPushButton#ZoomFit:hover,
QPushButton#Zoom100:hover {
    color: #444444;
}

QPushButton#ZoomFit:checked,
QPushButton#Zoom100:checked {
    color: #111111;
}

QPushButton#ExportButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4d1020, stop:1 #c8622a);
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 0px 12px;
}

QPushButton#ExportButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #5e1528, stop:1 #d97038);
}
