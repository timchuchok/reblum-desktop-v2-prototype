    <qresource prefix="/">
        <file alias="themes/dark.qss">../assets/themes/dark.qss</file>
        <file alias="themes/light.qss">../assets/themes/light.qss</file>
        <file alias="icons/eye-show.svg">../assets/icons/eye-show.svg</file>
        <file alias="icons/slider-thumb.svg">../assets/icons/slider-thumb.svg</file>
        <file alias="icons/slider-thumb-hover.svg">../assets/icons/slider-thumb-hover.svg</file>
        <file alias="icons/slider-thumb-disabled.svg">../assets/icons/slider-thumb-disabled.svg</file>
    </qresource>
</RCC>
